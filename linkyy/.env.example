# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public origin of the app, used for auth redirects (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables tests/db (a superuser Postgres connection; a throwaway DB is created per run).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
